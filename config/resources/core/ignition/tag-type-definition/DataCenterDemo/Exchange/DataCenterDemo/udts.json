      },
      "EnableDatasetInput": {
        "dataType": "Integer",
        "value": 1
      },
      "TypeId": {
        "dataType": "String",
        "value": "[DataCenterDemo]_types_/Exchange/DataCenterDemo/Equipment/Heatmap/Sensor"
      },
      "TimesNested": {
        "dataType": "Integer",
        "value": 0
      },
      "EnableAutomaticTrigger": {
        "dataType": "Integer",
        "value": 0
      }
    },
    "tagType": "UdtType",
    "tags": [
      {
        "name": "Config",
        "tagType": "Folder",
        "tags": [
          {
            "valueSource": "memory",
            "dataType": "DataSet",
            "name": "Dataset",
            "tagType": "AtomicTag"
          },
          {
            "eventScripts": [
              {
                "eventid": "valueChanged",
                "script": "\tsystem.tag.writeAsync([\"[.]ExecuteGenerate\"], [True])"
              }
            ],
            "valueSource": "expr",
            "expression": "jsonGet(\r\n\t\"{\u0027doc\u0027:{\"\r\n\t\t+\"\u0027AtomicName\u0027:\u0027\"+{AtomicName}+\"\u0027\"\r\n\t\t+\",\u0027EnableAutomaticTrigger\u0027:\"+{EnableAutomaticTrigger}\r\n\t\t+\",\u0027EnableDatasetInput\u0027:\"+{EnableDatasetInput}\r\n\t\t+\",\u0027TypeId\u0027:\u0027\"+{TypeId}+\"\u0027\"\r\n\t\t+\",\u0027TypeIdInstanceName\u0027:\u0027\"+{TypeIdInstanceName}+\"\u0027\"\r\n\t\t+\",\u0027UseExpressions\u0027:\"+{UseExpressions}\r\n\t+\"}}\"\r\n, \"doc\")",
            "dataType": "Document",
            "name": "ParameterWatchdog",
            "value": {
              "key": "value",
              "key_1": "value"
            },
            "tagType": "AtomicTag"
          },
          {
            "eventScripts": [
              {
                "eventid": "valueChanged",
                "script": "\tif currentValue.value:\n\t\tstartTime \u003d system.date.now()\n\t\t\n\t\t# read tags and parameters\n\t\ttags \u003d system.tag.readBlocking([\n\t\t\t  \"[.]../Parameters.PathToParentFolder\"\n\t\t\t, \"[.]../Parameters.atomicName\"\n\t\t\t, \"[.]../Parameters.TypeId\"\n\t\t\t, \"[.]../Parameters.TypeIdInstanceName\"\n\t\t\t, \"[.]../Parameters.EnableDatasetInput\"\n\t\t\t, \"[.]DatasetInput\"\n\t\t\t, \"[.]../Parameters.UseExpressions\"\n\t\t\t, \"[.]../Parameters.TimesNested\"\n\t\t\t, \"[.]RootInstanceName\"\n\t\t])\n\t\tpathToThisUdt \u003d tags[0].value\t\n\t\tatomicName \u003d tags[1].value\n\t\ttypeId \u003d tags[2].value\n\t\ttypeIdInstanceName \u003d tags[3].value\n\t\tenableDatasetInput \u003d tags[4].value\n\t\tdatasetInput \u003d tags[5].value\n\t\tuseExpressions \u003d tags[6].value\n\t\ttimesNested \u003d tags[7].value\n\t\trootInstanceName \u003d tags[8].value\n\t\t\n\t\t# if this UDT is nested in other UDT correct path\n\t\tpathToParentFolder \u003d pathToThisUdt\n\t\tignorePath \u003d \u0027%s/%s\u0027 % (pathToThisUdt, rootInstanceName)\n\t\tif timesNested \u003e 0:\n\t\t\tpathToParentFolder \u003d \u0027/\u0027.join(pathToThisUdt.split(\u0027/\u0027)[:-timesNested])\n\t\t\tif timesNested \u003e 1:\n\t\t\t\tignorePath \u003d \u0027/\u0027.join(pathToThisUdt.split(\u0027/\u0027)[:-(timesNested-1)])\n\n\t\t\n\t\t# determine if using input dataset or browsing\n\t\tif enableDatasetInput \u003d\u003d 0:\n\t\t\t# browsing\n\t\t\t# if TypeId is defined search for it, otherwise look for atomic tags\n\t\t\tif typeId \u003d\u003d \u0027*\u0027:\n\t\t\t\tudts \u003d [{\u0027fullPath\u0027: pathToParentFolder}]\n\t\t\telse:\n\t\t\t\tudts \u003d system.tag.browse(pathToParentFolder, \n\t\t\t\t\t{\u0027typeId\u0027: typeId.rsplit(\u0027_types_/\u0027)[-1], \u0027name\u0027: typeIdInstanceName, \u0027tagType\u0027:\u0027UdtInstance\u0027, \u0027recursive\u0027: True}\n\t\t\t\t).getResults()\n\t\t\t\n\t\n\t\t\t# browse every UDT for atomic tags to compile a dataset of tags\n\t\t\ttagPaths \u003d []\n\t\t\tfor udt in udts:\n\t\t\t\tatomics \u003d system.tag.browse(str(udt[\u0027fullPath\u0027]), \n\t\t\t\t\t{\u0027tagType\u0027:\u0027AtomicTag\u0027, \u0027name\u0027: atomicName,\u0027recursive\u0027:True}\n\t\t\t\t).getResults()\n#\t\t\t\ttagPaths +\u003d [str(atomic[\u0027fullPath\u0027]) for atomic in atomics]\n\t\t\t\ttagPaths +\u003d [str(atomic[\u0027fullPath\u0027]) for atomic in atomics if ignorePath not in str(atomic[\u0027fullPath\u0027])]\n\t\telse:\n\t\t\t# using input dataset\n\t\t\tif datasetInput:\n\t\t\t\ttagPaths \u003d list(datasetInput.getColumnAsList(0))\n\t\t\telse:\n\t\t\t\ttagPaths \u003d []\n\t\tbrowseEnd \u003d system.date.now()\t\n\t\t\n\t\t# read current tag values and convert to dataset\n\t\tif tagPaths:\n\t\t\ttagValues \u003d system.tag.readBlocking(tagPaths)\n\t\t\tdata \u003d [[tagPaths[i], tagValues[i].value] for i in xrange(len(tagPaths))]\n\t\telse:\n\t\t\tdata \u003d []\n\t\theaders \u003d [\u0027fullPath\u0027, \u0027value\u0027]\n\t\tdataset \u003d system.dataset.toDataSet(headers, data)\n\t\t\n\t\t# configure tags to use expressions or keep default\n\t\tlistOfTags \u003d \u0027{%s}\u0027 % \u0027},{\u0027.join([tp for tp in tagPaths])\n\t\taggTags \u003d system.tag.getConfiguration(\"[.]../Output\", True)\n\t\tfor aTag in aggTags[0][\u0027tags\u0027]:\n\t\t\tif useExpressions:\n\t\t\t\tif aTag[\u0027name\u0027] \u003d\u003d \u0027Count\u0027:\n\t\t\t\t\taTag.pop(\u0027expression\u0027, None) # will return to original \n\t\t\t\telse:\n\t\t\t\t\taTag[\u0027expression\u0027] \u003d \u0027%s(%s)\u0027 % (aTag[\u0027name\u0027], listOfTags)\n\t\t\telse:\n\t\t\t\taTag.pop(\u0027expression\u0027, None) # will return to original \n\t\t\t\t\n\t\t\t# remove unnecessary properties to reduce overrides\n\t\t\taTag.pop(\u0027valueSource\u0027, None)\n\t\t\taTag.pop(\u0027dataType\u0027, None)\n\t\tconf \u003d system.tag.configure(\"[.]../\", aggTags, collisionPolicy \u003d \u0027o\u0027)\n\t\t\t\n\t\t# write to tags\n\t\twritePaths \u003d [\n\t\t\t \"[.]Dataset\"\n\t\t\t,\"[.]Status\"\n\t\t\t,\"[.]ExecuteTime\"\n\t\t\t,tagPath\n\t\t]\n\t\twriteValues \u003d [\n\t\t\tdataset\n#\t\t\t,\u0027Path: %s Browse: %d Config: %d\u0027 % (pathToParentFolder, system.date.millisBetween(startTime, browseEnd), system.date.millisBetween(browseEnd, system.date.now()))\n\t\t\t,\u0027BrowsePath: %s IgnorePath: %s Browse: %d Config: %d\u0027 % (pathToParentFolder, ignorePath, system.date.millisBetween(startTime, browseEnd), system.date.millisBetween(browseEnd, system.date.now()))\n\t\t\t,system.date.millisBetween(startTime, system.date.now())\n\t\t\t,False\n\t\t]\n\t\tsystem.tag.writeAsync(writePaths, writeValues)"
              }
