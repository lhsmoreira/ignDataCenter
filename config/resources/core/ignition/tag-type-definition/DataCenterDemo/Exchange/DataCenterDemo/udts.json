[
  {
    "name": "AggregateCurrentHistory",
    "typeId": "",
    "tagType": "UdtType",
    "tags": [
      {
        "eventScripts": [
          {
            "eventid": "valueChanged",
            "script": "\t\tif currentValue.value:\n\t\t\tscriptStart \u003d system.date.now()\n\t\t\t\n\t\t\treadPaths \u003d [\u0027%s/CurrentA\u0027, \u0027%s/CurrentB\u0027, \u0027%s/CurrentC\u0027, \u0027%s/CurrentAbcMean\u0027]\n\t\t\taggregationModesList \u003d [\"Minimum\", \"Average\", \"Maximum\"]\n\t\t\taggregationTags \u003d [\"%s24HourLow\", \"%s24HourMean\", \"%s24HourHigh\"]\n\t\t\t\n\t\t\trootPath \u003d \u0027/\u0027.join(tagPath.split(\u0027/\u0027)[0:-2])\n\t\t\t\n\t\t\tpaths \u003d [p % rootPath for p in readPaths for am in aggregationModesList]\n\t\t\taggregationModes \u003d [am for p in readPaths for am in aggregationModesList]\n\t\t\twritePaths \u003d [at % (p % rootPath) for p in readPaths for at in aggregationTags]\n\t\t\t\n\t\t\tstartTime \u003d system.date.addHours(scriptStart, -24)\n\t\t\tdataset \u003d system.tag.queryTagHistory(\n\t\t\t\tpaths\u003dpaths\n\t\t\t\t, startDate\u003dstartTime\n\t\t\t\t, endDate\u003dscriptStart\n\t\t\t\t, returnSize\u003d1\n\t\t\t\t, aggregationModes\u003daggregationModes\n\t\t\t\t, returnFormat\u003d\u0027Wide\u0027\n\t\t\t)\n\t\t\twriteValues \u003d [dataset.getValueAt(0, i) for i in xrange(1,dataset.getColumnCount())]\n\t\t\tsystem.tag.writeAsync(writePaths, writeValues)"
          }
        ],
        "valueSource": "reference",
        "dataType": "DateTime",
        "sourceTagPath": "[~]Exchange/DataCenterDemo/HeatmapOrchestrator/ClockSlow",
        "name": "Trigger",
        "formatString": "yyyy-MM-dd h:mm:ss aa",
        "tagType": "AtomicTag"
      }
    ]
  },
